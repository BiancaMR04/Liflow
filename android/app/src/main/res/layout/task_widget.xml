<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/liflow_widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/task_card_bg"
        android:elevation="5dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tudo em dia"
            android:textColor="#282025"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Respira. O proximo passo aparece aqui."
            android:textColor="#8B7C82"
            android:textSize="12sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/task_card_bg"
        android:elevation="7dp"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/icon_stack"
            android:layout_width="44dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="2dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_icon_line"
                android:text="" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_circle_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_briefcase" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/check_circle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/check_circle_bg"
            android:gravity="center"
            android:text=""
            android:textColor="#00FFFFFF"
            android:textSize="1sp" />

        <LinearLayout
            android:id="@+id/text_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/time_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="em 15 min"
                android:textColor="#8E7F86"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Designing"
                android:textColor="#21191E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/time_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="09:30"
                android:textColor="#A08F96"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
